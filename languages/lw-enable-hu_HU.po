#: includes/Admin/Hub/Activator.php:48
msgid "This is not an LW plugin."
msgstr "Ez nem LW bővítmény."

#: includes/Admin/Hub/Activator.php:54
msgid "This plugin is not installed."
msgstr "Ez a bővítmény nincs telepítve."

#: includes/Admin/Hub/Activator.php:62
msgid "You are not allowed to activate this plugin."
msgstr "Nincs jogod bekapcsolni ezt a bővítményt."

#: includes/Admin/Hub/Page.php:135
msgid ""
"The LW Plugins page files are missing. Re-install the plugin from a release "
"ZIP."
msgstr ""
"Hiányoznak az LW Plugins oldal fájljai. Telepítsd újra a bővítményt egy "
"kiadási ZIP-ből."

#: includes/Admin/Hub/RegistryFallback.php:32
msgid "GDPR-compliant cookie consent banner."
msgstr "GDPR-kompatibilis sütihozzájárulási sáv."

#: includes/Admin/Hub/RegistryFallback.php:41
msgid "Disable WordPress features like comments."
msgstr "WordPress-funkciók kikapcsolása, például a hozzászólásoké."

#: includes/Admin/Hub/RegistryFallback.php:50
msgid "Enable WordPress features: SVG uploads and more."
msgstr "WordPress-funkciók bekapcsolása: SVG-feltöltés és egyebek."

#: includes/Admin/Hub/RegistryFallback.php:59
msgid "Rate limiting, bot blocking, IP bans and security headers."
msgstr "Kéréskorlátozás, botszűrés, IP-tiltás és biztonsági fejlécek."

#: includes/Admin/Hub/RegistryFallback.php:68
msgid ""
"Lightweight image optimization — auto-convert uploads to WebP via HelloImg."
msgstr ""
"Könnyű képoptimalizálás: a feltöltések automatikus WebP-konverziója a "
"HelloImg-gel."

#: includes/Admin/Hub/RegistryFallback.php:77
msgid ""
"Headless LMS backend: courses, lessons, access, progress and quizzes over a "
"REST API."
msgstr ""
"Headless LMS-háttér: kurzusok, leckék, hozzáférés, haladás és kvízek REST "
"API-n."

#: includes/Admin/Hub/RegistryFallback.php:86
msgid ""
"Tracking pixels: Meta, GA4, Ads, GTM, TikTok, Pinterest, Bing, Reddit, "
"Snapchat, X."
msgstr ""
"Követőpixelek: Meta, GA4, Ads, GTM, TikTok, Pinterest, Bing, Reddit, "
"Snapchat, X."

#: includes/Admin/Hub/RegistryFallback.php:95
msgid "Malware scanner for files, the database and vulnerable software."
msgstr ""
"Kártevőkereső a fájlokhoz, az adatbázishoz és a sérülékeny szoftverekhez."

#: includes/Admin/Hub/RegistryFallback.php:104
msgid "Essential SEO features without the bloat."
msgstr "A lényeges SEO-funkciók, felesleg nélkül."

#: includes/Admin/Hub/RegistryFallback.php:113
msgid "Site maintenance via AI/REST using Abilities API."
msgstr "Oldalkarbantartás AI-on és REST-en át, az Abilities API-val."

#: includes/Admin/Hub/RegistryFallback.php:122
msgid "Manage WordPress translations from community repositories."
msgstr "WordPress-fordítások kezelése közösségi tárolókból."

#: includes/Admin/Hub/RegistryFallback.php:131
msgid "Clean up your admin — notices sidebar & widget manager."
msgstr "Rendezett admin: értesítési oldalsáv és widgetkezelő."

#: includes/Admin/Settings/FieldsData.php:25
msgid "Media"
msgstr "Média"

#: includes/Admin/Settings/FieldsData.php:28
msgid "SVG Uploads"
msgstr "SVG feltöltések"

#: includes/Admin/Settings/FieldsData.php:41
msgid "Allow SVG file uploads with security sanitization"
msgstr "SVG fájlok feltöltésének engedélyezése biztonsági tisztítással"

#: includes/Admin/SettingsPage.php:61 includes/Admin/SettingsPage.php:62
#: includes/SiteManager/Integration.php:38
msgid "Enable"
msgstr "Engedélyezés"

#: includes/Admin/SettingsPage.php:130
msgid "Lightweight Enable"
msgstr "Lightweight Enable"

#: includes/Admin/SettingsPage.php:131
msgid ""
"The settings screen files are missing. Re-install the plugin from a release "
"ZIP, or run \"npm install && npm run build\" in the plugin directory."
msgstr ""
"Hiányoznak a beállítási képernyő fájljai. Telepítsd újra a bővítményt egy "
"kiadási ZIP-ből, vagy futtasd az „npm install && npm run build” parancsot a "
"bővítmény könyvtárában."

#: includes/Plugin.php:121 assets/hub/index.js:2 build/index.js:1
msgid "Settings"
msgstr "Beállítások"

#: includes/SiteManager/EnableAbilities.php:38
msgid "Get Enable Options"
msgstr "Engedélyezési beállítások lekérése"

#: includes/SiteManager/EnableAbilities.php:39
msgid "Get all LW Enable feature toggle settings."
msgstr "Az összes LW Enable funkciókapcsoló beállításának lekérése."

#: includes/SiteManager/EnableAbilities.php:69
msgid "Set Enable Options"
msgstr "Engedélyezési beállítások módosítása"

#: includes/SiteManager/EnableAbilities.php:70
msgid "Toggle LW Enable features on or off."
msgstr "LW Enable funkciók be- vagy kikapcsolása."

#: includes/SiteManager/EnableAbilities.php:80
msgid "Feature flags to update. Keys: svg (bool)."
msgstr "Módosítandó funkciókapcsolók. Kulcsok: svg (bool)."

#: includes/SiteManager/EnableService.php:49
msgid "Provide an options object with at least one feature key."
msgstr "Adj meg egy beállítás-objektumot legalább egy funkciókulccsal."

#. translators: %s: comma-separated list of valid keys
#: includes/SiteManager/EnableService.php:69
#, php-format
msgid "No valid feature keys provided. Valid keys: %s."
msgstr "Nincs érvényes funkciókulcs megadva. Érvényes kulcsok: %s."

#. translators: %d: number of options updated
#: includes/SiteManager/EnableService.php:82
#, php-format
msgid "%d option(s) updated."
msgstr "%d beállítás frissítve."

#: includes/SiteManager/Integration.php:39
msgid "WordPress feature toggle abilities"
msgstr "WordPress funkciókapcsoló képességek"

#: includes/Svg/Upload.php:34
msgid "Invalid file type. Only SVG files are allowed."
msgstr "Érvénytelen fájltípus. Csak SVG fájlok engedélyezettek."

#: includes/Svg/Upload.php:39
msgid "SVG file exceeds maximum size limit of 5MB."
msgstr "Az SVG fájl túllépi az 5MB-os maximális méretkorlátot."

#: includes/Svg/Upload.php:44 includes/Svg/Upload.php:72
#: includes/Svg/Upload.php:101
msgid "SVG file contains dangerous content."
msgstr "Az SVG fájl veszélyes tartalmat tartalmaz."

#: includes/Svg/Upload.php:65
msgid "Invalid file path."
msgstr "Érvénytelen fájlútvonal."

#: lw-enable.php:40
msgid ""
"Autoloader not found. Please run \"composer install\" in the plugin "
"directory, or re-install the plugin from a release ZIP."
msgstr ""
"Az autoloader nem található. Futtasd a „composer install” parancsot a "
"bővítmény könyvtárában, vagy telepítsd újra a bővítményt egy kiadási ZIP-ből."

