{
    "name": "lwplugins/lw-enable",
    "description": "Enable WordPress features: SVG uploads and more.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "LW Plugins",
            "homepage": "https://lwplugins.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "composer/installers": "^2.0"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.0",
        "wp-coding-standards/wpcs": "^3.0",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "php-stubs/woocommerce-stubs": "^10.9",
        "php-stubs/wp-cli-stubs": "^2.12",
        "phpunit/phpunit": "^10.0",
        "brain/monkey": "^2.6"
    },
    "autoload": {
        "psr-4": {
            "LightweightPlugins\\Enable\\": "includes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LightweightPlugins\\Enable\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "phpcs": "phpcs",
        "phpcbf": "phpcbf",
        "analyse": "phpstan analyse --memory-limit=2G",
        "test": "phpunit"
    }
}
